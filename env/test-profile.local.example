# Copy to .env.test-profile.local and fill with sandbox/test values.
# Keep canonical runtime names so app code paths stay unchanged.

# Required canonical runtime vars
STRIPE_SECRET_KEY=sk_test_replace_me
RESEND_API_KEY=re_test_replace_me
HOST_EMAIL=host-test@example.com

# Required for local runtime in this repo (can match your normal local values if unchanged)
PRICELABS_API_KEY=pricelabs_test_replace_me
STUDIO_ICAL_URL=https://example.invalid/studio.ics
ONEBR_ICAL_URL=https://example.invalid/one-bedroom.ics

# Stripe webhook secret must match your local stripe listen forwarder session.
STRIPE_WEBHOOK_SECRET=whsec_test_replace_me

# If your secrets manager uses *_TEST_* names, copy those values into the canonical keys above.
